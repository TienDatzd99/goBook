PORT=3001
JWT_SECRET=replace_with_strong_secret

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="goBook" <noreply@your-domain.com>

GOOGLE_CLIENT_ID=your_google_client_id_here

REQUIRE_EMAIL_VERIFICATION=true

FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URLS=https://your-frontend.vercel.app,https://www.your-domain.com
ALLOW_VERCEL_PREVIEWS=true

VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=https://your-frontend.vercel.app/thanh-toan/ket-qua

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=https://your-frontend.vercel.app/thanh-toan/ket-qua
MOMO_IPN_URL=https://your-backend.railway.app/api/payment/momo/ipn

# ─────────────────────────────────────────────────────────────────────────────
# PAYOS - Đăng ký tại: https://my.payos.vn/
# ─────────────────────────────────────────────────────────────────────────────
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_WEBHOOK_URL=https://your-backend.railway.app/api/payment/payos/webhook

# Webhook tolerance (VND) – amount must be >= order.total - WEBHOOK_AMOUNT_TOLERANCE
WEBHOOK_AMOUNT_TOLERANCE=1000

GEMINI_API_KEY=your_gemini_api_key
